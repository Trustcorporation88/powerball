# Powerball — schema da API (login, termo, carteira de palpites).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("user")
  createdAt    DateTime @default(now())

  projects     Project[]
  lotteryGames LotteryWalletGame[]
  termAcceptances LotteryTermAcceptance[]
}

model Project {
  id            String   @id
  userId        String
  name          String
  segment       String   @default("")
  status        String   @default("active")
  createdAt     DateTime @default(now())
  lastProcessed DateTime?

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  file         FileData?
  mappings     ColumnMapping[]
  transactions Transaction[]
  layout       DashboardLayout?
  dreRules     DRERule[]

  @@index([userId])
}

model FileData {
  id             String  @id @default(uuid())
  projectId      String  @unique
  name           String
  sheets         Json
  selectedSheet  String
  selectedSheets Json?
  importMode     String?
  headers        Json
  preview        Json
  allData        Json

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ColumnMapping {
  id            String @id @default(uuid())
  projectId     String
  originalName  String
  detectedType  String
  confirmedType String
  financialRole String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Transaction {
  id              String  @id
  projectId       String
  date            String
  description     String
  category        String
  dreGroup        String?
  dreOriginalGroup String?
  subcategory     String
  account         String
  costCenter      String
  unit            String
  value           Float
  currency        String
  flowType        String

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model DashboardLayout {
  id        String @id @default(uuid())
  projectId String @unique
  name      String
  layout    Json

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model DRERule {
  id        String   @id
  projectId String
  field     String
  operator  String
  value     String
  dreGroup  String
  priority  Int      @default(0)
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ShareSnapshot {
  token        String   @id
  createdAt    String
  projectName  String
  snapshotJson String
}

/// Cache dos concursos da Caixa.
/// A API oficial responde 403 para requisições vindas de datacenter e não
/// expõe CORS, então o servidor busca, normaliza e guarda o resultado aqui —
/// o navegador do visitante consulta este cache em vez da Caixa.
model LotteryDrawCache {
  id         String   @id @default(uuid())
  lottery    String
  concurso   Int
  data       String
  /// Dezenas do sorteio principal.
  dezenas    Json
  /// 2º sorteio da Dupla Sena.
  dezenas2   Json?
  /// Mês da Sorte (Dia de Sorte).
  mesSorte   String?
  /// Trevos da Sorte (+Milionária).
  trevos     Json?
  acumulou   Boolean  @default(false)
  premiacoes Json?
  payload    Json?
  updatedAt  DateTime @updatedAt

  @@unique([lottery, concurso])
  @@index([lottery, concurso])
}

/// Registro do aceite do termo de uso e isenção de responsabilidade.
/// Guarda a versão exata do texto aceito: sem isso não dá para provar a que o
/// usuário concordou quando o texto mudar. Um registro por versão, preservando
/// o histórico de aceites anteriores.
model LotteryTermAcceptance {
  id         String   @id @default(uuid())
  userId     String
  version    String
  acceptedAt DateTime @default(now())
  ip         String?
  userAgent  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@index([userId])
}

/// Carteira de bilhetes sincronizada entre dispositivos.
model LotteryWalletGame {
  id            String   @id
  userId        String
  lottery       String
  numbers       Json
  extra         Json?
  strategy      String
  strategyLabel String
  cost          Float
  score         Int
  scoreLabel    String
  analysis      Json?
  isBet         Boolean  @default(false)
  notes         String?
  folder        String?
  bolaoId       String?
  checkResult   Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, lottery])
}
