# Conexão Postgres (no Railway, use a referência ${{ Postgres.DATABASE_URL }})
DATABASE_URL="postgresql://user:password@host:5432/datafin?schema=public"

# Segredo para assinar os JWT (gere algo longo e aleatório)
JWT_SECRET="troque-por-um-segredo-bem-grande-e-aleatorio"

# Porta (Railway injeta PORT automaticamente)
PORT=8080
HOST=0.0.0.0

# Origens permitidas (CORS). Liste as URLs do frontend separadas por vírgula.
# Inclua o domínio de produção e o domínio do Vercel.
# Ex.: https://fin.trustcorp.com.br,https://merry-parrot-scurry.vercel.app
# Use "*" apenas em desenvolvimento.
CORS_ORIGIN="https://fin.trustcorp.com.br"
