# Conexão Postgres. No Powerball usamos o Supabase:
# Project Settings → Database → Connection string → URI
DATABASE_URL="postgresql://postgres.xxxx:senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Segredo para assinar os JWT. No Railway pode deixar o gerador:
# ${{ secret(44, "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789") }}
JWT_SECRET="troque-por-um-segredo-bem-grande-e-aleatorio"

# Porta (Railway injeta PORT automaticamente)
PORT=8080
HOST=0.0.0.0

# Origens permitidas (CORS). Só os endereços do site Powerball.
# Use "*" apenas em desenvolvimento.
CORS_ORIGIN="https://play.xbrex.com.br,https://powerballbr.com.br,https://www.powerballbr.com.br"
