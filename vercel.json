{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/projects/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/dre/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/excel-assistant/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/loterias/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/loterias-publico",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
