# API Configuration
VITE_API_URL=http://localhost:3000/api
VITE_API_TIMEOUT=30000

# Authentication
VITE_AUTH_TOKEN_KEY=analise_planilha_token
VITE_AUTH_STORAGE=localStorage

# Features
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_TRACKING=false

# Logging
VITE_LOG_LEVEL=info
VITE_LOG_DESTINATION=console

# File Upload
VITE_MAX_FILE_SIZE=52428800
VITE_ALLOWED_FILE_TYPES=xlsx,xlsm,csv

# Development
VITE_DEV_MODE=false
VITE_DEBUG=false
