# ── Frontend (Vite) ──────────────────────────────────────────────────────────

# Backend de dados (Railway). Deixe VAZIO para usar o armazenamento local
# (IndexedDB, no navegador). Defina para a URL pública do serviço no Railway
# para usar o banco central (Postgres). Ex.: https://datafin-api.up.railway.app
VITE_API_URL=

# Chave da API DeepSeek (opcional). Também pode ser configurada em tempo de
# execução na tela Configurações → Integração de IA.
VITE_DEEPSEEK_API_KEY=

# Domínio oficial do site. O mesmo build também atende pelo endereço
# *.up.railway.app; definir isto fixa a URL canônica das páginas de resultado
# em um único domínio e evita conteúdo duplicado no Google.
VITE_SITE_URL=https://powerballbr.com.br
